# Copy to api/.env and fill in. Never commit api/.env.
PORT=4000
HOST=127.0.0.1
# Local PostgreSQL (PGlite) folder and uploaded-file folder, relative to api/
DATA_DIR=data/pgdata
STORAGE_DIR=storage/uploads
# Set to true when served over HTTPS
COOKIE_SECURE=false
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# First-run bootstrap (only used when the database is empty)
TENANT_NAME=Demo Museum
TENANT_SLUG=demo-museum
ADMIN_EMAIL=admin@example.com
# Min 12 characters
ADMIN_PASSWORD=change-me-to-a-long-password

# ---- Optional: use Supabase instead of the local PGlite folder / disk ----
# Postgres connection string (Supabase → Project Settings → Database → Transaction pooler)
# DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Logo storage in Supabase Storage (service_role key — server-side only, never in the apps)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Browser origins allowed to call this API cross-origin (hosted apps)
# CORS_ORIGINS=https://vc-chitrang.github.io

# ---- Deploying the API to Supabase Edge Functions (npm run deploy:supabase -w api) ----
# Personal access token: supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=xzaaiztphayjjnvkkmvl
