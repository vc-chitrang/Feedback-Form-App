# Copy to api/.env and fill in. Never commit api/.env.
PORT=4000
HOST=127.0.0.1
# Local PostgreSQL (PGlite) folder and uploaded-file folder, relative to api/
DATA_DIR=data/pgdata
STORAGE_DIR=storage/uploads
# Set to true when served over HTTPS
COOKIE_SECURE=false
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# First-run bootstrap (only used when the database is empty)
TENANT_NAME=Demo Museum
TENANT_SLUG=demo-museum
ADMIN_EMAIL=admin@example.com
# Min 12 characters
ADMIN_PASSWORD=change-me-to-a-long-password
